<Window x:Class="CreateQRcode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QRコード作成"
        Height="720"
        Width="680"
        MinHeight="580"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7"
        FontFamily="Yu Gothic UI"
        FontSize="14"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1F6B4A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#18563B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#124530"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#1C2430"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#C9D1D9"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F7F8FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EEF1F4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B95A1"/>
                                <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="QRコード作成"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#1C2430"/>
            <TextBlock Margin="0,6,0,0"
                       Text="リンクを貼り付けて、QRコードを表示・コピー・保存します。"
                       Foreground="#5C6773"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="URL" FontWeight="SemiBold" Foreground="#1C2430" Margin="0,0,0,8"/>
            <TextBox x:Name="UrlTextBox"
                     Height="42"
                     Padding="12,0"
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     BorderBrush="#C9D1D9"
                     BorderThickness="1"
                     Background="White"
                     TextChanged="UrlTextBox_TextChanged"
                     KeyDown="UrlTextBox_KeyDown"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CreateButton"
                        Content="作成"
                        Style="{StaticResource PrimaryButton}"
                        Click="CreateButton_Click"/>
                <Button x:Name="CopyButton"
                        Margin="10,0,0,0"
                        Content="コピー"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="False"
                        Click="CopyButton_Click"/>
                <Button x:Name="SaveButton"
                        Margin="10,0,0,0"
                        Content="保存"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="False"
                        Click="SaveButton_Click"/>
            </StackPanel>
            <TextBlock Margin="0,8,0,0"
                       Foreground="#5C6773"
                       Text="コピーは画像をクリップボードへ。保存では場所と形式を選べます。"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="3"
                Margin="0,18,0,14"
                Background="White"
                BorderBrush="#D8DEE6"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">
            <Grid>
                <TextBlock x:Name="PlaceholderText"
                           Text="作成ボタンを押すと、ここにQRコードが表示されます"
                           Foreground="#8B95A1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <Image x:Name="QrImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Foreground="#5C6773"
                   TextWrapping="Wrap"
                   Text="URLを貼り付けて、作成を押してください。"/>
    </Grid>
</Window>
